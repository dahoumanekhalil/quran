root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,md,toml}]
indent_size = 2

[*.{xml,html}]
indent_size = 2

[Makefile]
indent_style = tab

# Do not touch vendored third-party sources.
[data/sources/**]
indent_style = unset
indent_size = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
