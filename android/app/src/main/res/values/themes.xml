<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base window theme. Uses DeviceDefault so the initial window matches the
      OS's dark/light preference BEFORE Compose renders — no white flash when
      the user has picked dark. Compose's MushafTheme takes over for the
      actual content the moment setContent runs.
    -->
    <style name="Theme.Mushaf" parent="android:Theme.DeviceDefault.NoActionBar" />
</resources>
