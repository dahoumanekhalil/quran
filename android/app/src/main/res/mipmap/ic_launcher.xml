<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy launcher icon for API 24-25 (pre-adaptive-icon support). Combines
  the background color + book-fold foreground into a single 108x108 vector.
  API 26+ picks up mipmap-anydpi-v26/ic_launcher.xml (the adaptive form)
  because the version-qualified resource has higher priority.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M 0,0 h 108 v 108 h -108 z" />
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M 34,36 h 18 v 36 h -18 z" />
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M 56,36 h 18 v 36 h -18 z" />
</vector>
